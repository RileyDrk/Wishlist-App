# Server only. Never prefix these with VITE_ or commit your real .env file.
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=merry_little_wishes
# Optional persistent photo directory; defaults to .data/uploads.
# UPLOADS_DIR=/data/wishlist/uploads
# On the deployed server, enable Secure session cookies and serve through HTTPS:
# NODE_ENV=production
# Atlas alternative: copy your deployment's driver URI from Atlas into .env.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
