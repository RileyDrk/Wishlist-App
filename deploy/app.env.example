# Copy to app.env ON THE LINUX SERVER and chmod 600 it.
# Use wishlist_app's password, not the MongoDB administrator password.
# Password characters must be URL encoded. Do not commit app.env.
MONGODB_URI=mongodb://wishlist_app:REPLACE_WITH_URL_ENCODED_PASSWORD@mongodb:27017/merry_little_wishes?authSource=merry_little_wishes
MONGODB_DB=merry_little_wishes
MONGODB_DOCKER_NETWORK=wishlist_default
PROXY_DOCKER_NETWORK=REPLACE_WITH_NPM_NETWORK
WISHLIST_PORT=3000
WISHLIST_IMAGE_TAG=v1
